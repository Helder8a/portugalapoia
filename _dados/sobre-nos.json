- file: "_dados/sobre-nos.json"
        label: "Página Sobre Nós"
        name: "sobre_nos"
        fields:
          - label: "Secção Principal (Hero)"
            name: "hero"
            widget: "object"
            fields:
              - {label: "Título Principal", name: "title", widget: "string"}
              - {label: "Imagem de Fundo", name: "image", widget: "image"}
          - label: "Introdução"
            name: "intro"
            widget: "object"
            fields:
              - {label: "Subtítulo", name: "subtitle", widget: "string"}
              - {label: "Texto Introdutório", name: "text", widget: "markdown"}
          - label: "Galeria de Imagens (Collage)"
            name: "gallery_images"
            widget: "list"
            summary: "Adicionar Imagens à Galeria"
            field: {label: "Imagem", name: "image", widget: "image"}
          - label: "Missão"
            name: "mission"
            widget: "object"
            fields:
              - {label: "Ícone (Font Awesome)", name: "icon", widget: "string", hint: "Ex: fas fa-bullseye"}
              - {label: "Título da Missão", name: "title", widget: "string"}
              - {label: "Texto da Missão", name: "text", widget: "text"}
          - label: "Princípios"
            name: "principles"
            widget: "list"
            fields:
              - {label: "Ícone (Font Awesome)", name: "icon", widget: "string", hint: "Ex: fas fa-hands-helping"}
              - {label: "Título do Princípio", name: "title", widget: "string"}
              - {label: "Texto do Princípio", name: "text", widget: "text"}